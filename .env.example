# Copy to .env and adjust. Never commit the real .env.

# --- Database (docker compose creates this database) ---
POSTGRES_USER=prophecy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prophecy
POSTGRES_PORT=5433
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://prophecy:change-me@localhost:5433/prophecy

# --- Backend ---
# development | test | production. Production refuses to start with an insecure SECRET_KEY.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true when served over HTTPS (required in production)
COOKIE_SECURE=false
# Comma-separated origins allowed to make browser requests. Docker derives it from
# FRONTEND_PORT when unset; set it for other setups (e.g. production domain).
# CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_UPLOAD_MB=50
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Load the bundled Land Registry sample on container start (docker only)
IMPORT_SAMPLE_DATA=true

# --- AI explanations (optional) ---
# none = deterministic rule-based explanations only. anthropic | openai to use a model.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
# Where the Next.js server proxies /api requests (build time and runtime)
API_ORIGIN=http://localhost:8000

# --- Host ports for docker compose ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
